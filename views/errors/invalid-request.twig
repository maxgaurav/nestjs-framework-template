{% extends './../layouts/master.twig' %}
{% block extraStyles %}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
{% endblock %}
{% block appTitle %}
  Invalid request
{% endblock %}
{% block bodyClasses %}d-flex align-items-center py-4 bg-body-tertiary justify-content-center vh-100{% endblock %}
{% block mainContent %}
  <main>
    <div class="card p-3 shadow">
      <div class="card-body">
        <h1 class="h4">This link is not valid</h1>
        <div class="alert alert-danger mb-0" role="alert" data-testid="invalid-request">
          <ul class="mb-0">
            {% for error in errors %}
              <li>{{ error }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </main>
{% endblock %}
