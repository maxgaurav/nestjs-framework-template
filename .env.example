# Application Settings
NODE_ENV=production
APP_PORT=3000
APP_URL=http://localhost
APP_MAX_HEAP_MEMORY=150
APP_MAX_RSS_MEMORY=150
APP_DEBUG=true
APP_SECRET=changeThisValue
# 16 characters; IV used by HashEncryptService (aes-256-ctr)
APP_ENCRYPT_HEX_KEY=

# Database settings
DB_HOST=localhost
DB_NAME=databaseName
DB_USERNAME=root
DB_PASSWORD=root
DB_PORT=5432
DB_DEBUG=false
DB_POOL_CONNECTION_LIMIT=2

#Node Cluster settings
CLUSTER_ENABLE=false
CLUSTER_MAX_CPU=0
CLUSTER_MAX_ATTEMPTS=10

# Mail settings
# smtp | log (prints the message, delivers nothing) | memory (tests)
MAIL_DRIVER=log
MAIL_FROM_NAME="No Reply"
# Must be a full address with a TLD: @nestjs/mail refuses to boot otherwise
MAIL_FROM_ADDRESS=noreply@example.com
# Send attempts, with backoff, for transient failures
MAIL_RETRY=3
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
# Optional JSON node:tls options, e.g. {"rejectUnauthorized":false}
MAIL_SMTP_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=

# File storage (@nestjs/storage): disks "private" (default, signed links) and "public" (URLs)
# local (folders under storage/app) | s3 (any S3-compatible bucket: AWS, R2, MinIO, B2, GCS)
STORAGE_DRIVER=local
# Local: folder holding private/ and public/ (default storage/app). S3: key prefix in the bucket
STORAGE_ROOT=
# Comma-separated, at least 32 characters each; the first signs, all verify (rotation).
# Empty: derived from APP_SECRET
STORAGE_SIGNING_KEYS=
# Route serving local signed links (default ${APP_URL}/files)
STORAGE_SIGNED_URL_BASE=
# Base URL of the public disk: default ${APP_URL}/storage locally, the bucket's public/ prefix on S3.
# Set it to a CDN in front of the public files when there is one
STORAGE_PUBLIC_URL=
S3_BUCKET=
S3_REGION=auto
# Custom endpoint for R2 / MinIO / B2; empty for AWS
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Empty: falls back to the AWS_* environment credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Session settings
SESSION_DRIVER=file
