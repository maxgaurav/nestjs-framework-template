{
  "name": "main-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node --enable-source-maps dist/main.js",
    "start:dev": "npm run build && concurrently -k -n tsc,app -c blue,green \"node node_modules/typescript-native/bin/tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch-path=./dist dist/main.js\"",
    "start:debug": "npm run build && concurrently -k -n tsc,app -c blue,green \"node node_modules/typescript-native/bin/tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --inspect --enable-source-maps --watch-path=./dist dist/main.js\"",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "app:command": "npm run -s build && node --enable-source-maps dist/cli.js",
    "tinker": "npm run -s build && node --enable-source-maps dist/tinker.js",
    "test:all": "vitest run",
    "tsgo": "node node_modules/typescript-native/bin/tsc",
    "prebuild": "rimraf dist",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.11.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/sequelize": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cls-hooked": "^4.2.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nest-commander": "^3.21.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-form-data": "^11.0.1",
    "nestjs-sequelize-paginate": "^1.0.0",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.35.1",
    "sequelize-typescript": "^2.1.6",
    "session-file-store": "^1.5.0",
    "swagger-ui-express": "^5.0.1",
    "ts-enum-util": "^4.1.0",
    "twig": "^3.0.0",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.2.0",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cls-hooked": "^4.3.9",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.17.8",
    "@types/inquirer": "^8.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/session-file-store": "^1.2.3",
    "@types/supertest": "^6.0.3",
    "@types/twig": "^1.12.12",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.4",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "bcrypt": true,
    "@nestjs/core": false,
    "@scarf/scarf": false
  },
  "overrides": {
    "nestjs-form-data": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core"
    },
    "nest-commander": {
      "@golevelup/nestjs-discovery": "^7.1.0"
    }
  },
  "type": "module"
}
